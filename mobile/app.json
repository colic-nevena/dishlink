{
    "expo": {
      "name": "dishlink",
      "slug": "dishlink",
      "version": "1.0.0",
      "orientation": "portrait",
      "icon": "./assets/images/logo.png",
      "scheme": "myapp",
      "userInterfaceStyle": "automatic",
      "newArchEnabled": true,
      "splash": {
        "image": "./assets/images/splashScreen.jpg",
        "resizeMode": "cover",
        "backgroundColor": "#FFF3E0"
      },
      "ios": {
        "supportsTablet": true
      },
      "android": {
        "adaptiveIcon": {
          "foregroundImage": "./assets/images/splashScreen.jpg",
          "backgroundColor": "#FFF3E0"
        },
        "package": "com.nevena.colic1810.dishlink"
      },
      "web": {
        "bundler": "metro",
        "output": "static",
        "favicon": "./assets/images/logo.png"
      },
      "plugins": [
        "expo-router",
        [
          "expo-splash-screen",
          {
            "image": "./assets/images/splashScreen.jpg",
            "resizeMode": "cover",
            "backgroundColor": "#FFF3E0",
            "imageWidth": 500
          }
        ],
        "expo-asset",
        [
          "expo-font",
          {
            "fonts": ["./assets/fonts/Pacifico-Regular.ttf"]
          }
        ]
      ],
      "experiments": {
        "typedRoutes": true
      },
      "extra": {
        "router": {
          "origin": false
        },
        "eas": {
          "projectId": "6e14da8a-b4ef-438a-a731-014c30faa92a"
        }
      }
    }
  }